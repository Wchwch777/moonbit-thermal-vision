///|
fn lut_index(value : Double) -> Int {
  (value.clamp(min=0.0, max=1.0) * 2047.0).round().to_int()
}

///|
pub fn ThermalMatrix::colorize_lut(
  matrix : ThermalMatrix,
  palette? : Palette = Ironbow,
  range? : TemperatureRange,
) -> ColorFrame {
  let chosen = match range {
    Some(value) => value
    None => try! matrix.range()
  }
  let table = match palette {
    Gray => gray_lut()
    Ironbow => ironbow_lut()
    BlueRed => blue_red_lut()
  }
  let span = chosen.span()
  let pixels = matrix.values.map(fn(value) {
    let normalized = if span <= 0.0 { 0.0 } else { (value - chosen.min) / span }
    table[lut_index(normalized)]
  })
  { width: matrix.width, height: matrix.height, pixels }
}

///|
pub fn lut_resolution() -> Int {
  2048
}
